    "services": {
        "load_time_program_draft": {
            "name": "Load pump schedule into draft",
            "description": "Read only. Replace the temporary draft with the controller week; clears validation and acknowledgements.",
            "fields": {
                "config_entry_id": {
                    "name": "HTHA entry ID",
                    "description": "Loaded HTHA integration config entry ID."
                },
                "program_index": {
                    "name": "Program index",
                    "description": "0 = hot water; 2 = primary heating."
                }
            }
        },
        "validate_time_program": {
            "name": "Check schedule draft",
            "description": "Validate the full week and explicitly verified Normal code. No pump writes.",
            "fields": {
                "config_entry_id": {
                    "name": "HTHA entry ID",
                    "description": "Loaded HTHA integration config entry ID."
                },
                "draft": {
                    "name": "Complete weekly draft",
                    "description": "entries: seven arrays of start/end (HH:MM) and integer state; explicitly cover 00:00–24:00."
                },
                "policy": {
                    "name": "Check policy",
                    "description": "kind: heating/hot_water; normal_state: user-attested advice mapping; mapping_confirmed: true after verification. The mapping does not translate or protect numeric codes written."
                }
            }
        },
        "acknowledge_time_program_warnings": {
            "name": "Acknowledge checked warnings",
            "description": "Acknowledge exactly the latest warning IDs bound to this draft hash. Critical errors cannot be overridden.",
            "fields": {
                "config_entry_id": {
                    "name": "HTHA entry ID",
                    "description": "Loaded HTHA integration config entry ID."
                },
                "draft_hash": {
                    "name": "Checked hash",
                    "description": "Exact draft_hash returned by the latest validation."
                },
                "warning_ids": {
                    "name": "Warning IDs",
                    "description": "Exactly all warning_ids from the latest check; read each before acknowledging."
                }
            }
        },
        "apply_time_program": {
            "name": "Apply checked schedule",
            "description": "Admin only. Requires Allow writes ON, checked unchanged draft, all warnings acknowledged and confirmation. Independent read-back; no automatic retry/rollback on partial failure.",
            "fields": {
                "config_entry_id": {
                    "name": "HTHA entry ID",
                    "description": "Loaded HTHA integration config entry ID."
                },
                "draft": {
                    "name": "Complete weekly draft",
                    "description": "entries: seven arrays of start/end (HH:MM) and integer state; explicitly cover 00:00–24:00."
                },
                "draft_hash": {
                    "name": "Checked hash",
                    "description": "Exact draft_hash returned by the latest validation."
                },
                "confirm": {
                    "name": "Confirm physical change",
                    "description": "Must be true. Apply and restore are the only scratchpad actions that write."
                }
            }
        },
        "refresh_time_program_baseline": {
            "name": "Refresh pump baseline, keep my draft",
            "description": "Read only. Keeps edits and invalidates validation and acknowledgements.",
            "fields": {
                "config_entry_id": {
                    "name": "HTHA entry",
                    "description": "Loaded HTHA integration entry."
                }
            }
        },
        "restore_previous_time_program": {
            "name": "Restore previous program",
            "description": "Check and acknowledge previous_program as the draft first. Requires Allow writes and explicit confirmation.",
            "fields": {
                "config_entry_id": {
                    "name": "HTHA entry",
                    "description": "Loaded HTHA integration entry."
                },
                "draft_hash": {
                    "name": "Checked hash"
                },
                "confirm": {
                    "name": "Confirm physical change"
                }
            }
        }
    },
    "exceptions": {
        "entry_not_loaded": {
            "message": "HTHA entry is not loaded."
        },
        "schedule_gate": {
            "message": "Schedule action refused: {reason}"
        }
    },
    "issues": {
        "schedule_recovery": {
            "title": "Schedule recovery required",
            "description": "An apply for {entry} failed or was interrupted. Refresh the baseline while keeping the draft, inspect actual_program and previous_program, then check and acknowledge the previous program before a confirmed restore. No automatic restore is performed."
        }
    }
}
